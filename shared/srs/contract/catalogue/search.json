{
  "version": 1,
  "area": "search",
  "methods": [
    {
      "name": "search.cards",
      "description": "Search card ids using Anki search syntax and sorting.",
      "mutating": false,
      "longOperation": false,
      "params": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "maxLength": 65536
          },
          "sort": {
            "type": "string",
            "maxLength": 255
          },
          "descending": {
            "type": "boolean"
          }
        },
        "required": [
          "search"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "cardIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": 100000
          }
        },
        "required": [
          "cardIds"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search.notes",
      "description": "Search note ids using Anki search syntax and sorting.",
      "mutating": false,
      "longOperation": false,
      "params": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "maxLength": 65536
          },
          "sort": {
            "type": "string",
            "maxLength": 255
          },
          "descending": {
            "type": "boolean"
          }
        },
        "required": [
          "search"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "noteIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": 100000
          }
        },
        "required": [
          "noteIds"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search.build",
      "description": "Build, join or replace escaped native search expressions from browser quick filters.",
      "mutating": false,
      "longOperation": false,
      "params": {
        "type": "object",
        "properties": {
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "deck",
                    "notetype",
                    "tag",
                    "flag",
                    "state",
                    "added",
                    "due",
                    "text",
                    "field",
                    "raw"
                  ]
                },
                "value": {
                  "type": "string",
                  "maxLength": 65536
                },
                "field": {
                  "type": "string",
                  "maxLength": 255
                },
                "negate": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          },
          "join": {
            "type": "string",
            "enum": [
              "and",
              "or"
            ]
          },
          "existingSearch": {
            "type": "string",
            "maxLength": 65536
          },
          "operation": {
            "type": "string",
            "enum": [
              "join",
              "replace"
            ]
          }
        },
        "required": [
          "terms",
          "join"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "search"
        ],
        "additionalProperties": false
      }
    }
  ]
}
