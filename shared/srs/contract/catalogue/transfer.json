    {
      "name": "transfer.importCsv",
      "description": "Import mapped CSV/TSV fields with explicit duplicate handling; leading metadata is limited to 2 MiB and the native five-record sample to 64 MiB.",
      "mutating": true,
      "longOperation": true,
      "params": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "maxLength": 256
          },
          "delimiter": {
            "type": "string",
            "maxLength": 1
          },
          "isHtml": {
            "type": "boolean"
          },
          "notetypeId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "deckId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mapping": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "column": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 511
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "field",
                    "tags",
                    "deck",
                    "notetype",
                    "guid",
                    "ignore"
                  ]
                },
                "fieldOrdinal": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 511
                }
              },
              "required": [
                "column",
                "target",
                "fieldOrdinal"
              ],
              "additionalProperties": false
            },
            "maxItems": 512
          },
          "duplicateMode": {
            "type": "string",
            "enum": [
              "update",
              "preserve",
              "new"
            ]
          },
          "matchScope": {
            "type": "string",
            "enum": [
              "notetype",
              "notetypeAndDeck"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1024
            },
            "maxItems": 1000
          }
        },
        "required": [
          "uploadId",
          "delimiter",
          "isHtml",
          "notetypeId",
          "deckId",
          "mapping",
          "duplicateMode",
          "matchScope",
          "tags"
        ],
        "additionalProperties": false
      },
