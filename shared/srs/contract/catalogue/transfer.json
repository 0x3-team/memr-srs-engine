                "type": "boolean"
              },
              "noteText": {
                "type": "boolean"
              },
              "studyQueues": {
                "type": "boolean"
              }
            },
            "required": [
              "card",
              "note",
              "deck",
              "tag",
              "notetype",
              "config",
              "deckConfig",
              "mtime",
              "browserTable",
              "noteText",
              "studyQueues"
            ],
            "additionalProperties": false
          },
          "undo": {
            "type": "object",
            "properties": {
              "canUndo": {
                "type": "boolean"
              },
              "undoLabel": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 255
              },
              "canRedo": {
                "type": "boolean"
              },
              "redoLabel": {
                "type": [
                  "string",
