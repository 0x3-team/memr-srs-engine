{
  "version": 1,
  "area": "provenance",
  "methods": [
    {
      "name": "provenance.ensureNotetypes",
      "description": "Create Memr Basic, reversed, Cloze and Type-in types with a hidden Source field.",
      "mutating": true,
      "longOperation": false,
      "params": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "notetypeIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": 100000
          },
          "changes": {
            "type": "object",
            "properties": {
              "card": {
                "type": "boolean"
              },
              "note": {
                "type": "boolean"
              },
              "deck": {
                "type": "boolean"
              },
              "tag": {
                "type": "boolean"
              },
              "notetype": {
                "type": "boolean"
              },
              "config": {
                "type": "boolean"
              },
              "deckConfig": {
                "type": "boolean"
              },
              "mtime": {
                "type": "boolean"
              },
              "browserTable": {
                "type": "boolean"
              },
              "noteText": {
                "type": "boolean"
              },
              "studyQueues": {
                "type": "boolean"
              }
            },
            "required": [
              "card",
              "note",
              "deck",
              "tag",
              "notetype",
              "config",
              "deckConfig",
              "mtime",
              "browserTable",
              "noteText",
              "studyQueues"
            ],
            "additionalProperties": false
          },
          "undo": {
            "type": "object",
            "properties": {
              "canUndo": {
                "type": "boolean"
              },
              "undoLabel": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 255
              },
              "canRedo": {
                "type": "boolean"
              },
              "redoLabel": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 255
              },
              "revision": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "canUndo",
              "undoLabel",
              "canRedo",
              "redoLabel"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "notetypeIds",
          "changes",
          "undo"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "provenance.sourceOf",
      "description": "Read source links preserved in a note's hidden Source field.",
      "mutating": false,
      "longOperation": false,
      "params": {
        "type": "object",
        "properties": {
          "noteId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "noteId"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pageId": {
                  "type": "string",
                  "maxLength": 256
                },
                "blockId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "revision": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 64
                },
                "uri": {
                  "type": "string",
                  "maxLength": 2048
                },
                "changed": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "pageId",
                "blockId",
                "revision",
                "uri",
                "changed"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          }
        },
        "required": [
          "sources"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "provenance.cardsForSource",
      "description": "Find cards by canonical page and optional block identity.",
      "mutating": false,
      "longOperation": false,
      "params": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "maxLength": 256
          },
          "blockId": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "pageId"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "cardIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": 100000
          },
          "noteIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": 100000
          }
        },
        "required": [
          "cardIds",
          "noteIds"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "provenance.checkSources",
      "description": "Compare stored revisions with current canonical hashes; null marks a missing source and cards remain unchanged.",
      "mutating": false,
      "longOperation": false,
      "params": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pageId": {
                  "type": "string",
                  "maxLength": 256
                },
                "blockId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "revision": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 64
                }
              },
              "required": [
                "pageId",
                "blockId",
                "revision"
              ],
              "additionalProperties": false
            },
            "maxItems": 10000
          }
        },
        "required": [
          "sources"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "noteId": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pageId": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "blockId": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 256
                      },
                      "revision": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 64
                      },
                      "uri": {
                        "type": "string",
                        "maxLength": 2048
                      },
                      "changed": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "current",
                          "changed",
                          "missing",
                          "untracked",
                          "unchecked"
                        ]
                      }
                    },
                    "required": [
                      "pageId",
                      "blockId",
                      "revision",
                      "uri",
                      "changed",
                      "status"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 1000
                }
              },
              "required": [
                "noteId",
                "sources"
              ],
              "additionalProperties": false
            },
            "maxItems": 10000
          }
        },
        "required": [
          "notes"
        ],
        "additionalProperties": false
      }
    }
  ]
}
